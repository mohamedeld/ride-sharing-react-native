{
  "expo": {
    "name": "Kerb",
    "slug": "kerb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kerb",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.reactbd.kerb",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NsLocationWhenInUseUsageDescription": "Kerb uses your location to find nearby driver",
        "NSPhotoLibraryUsageDescription": "Kerb needs access to your photo library so you can select and upload photos.",
        "NSCameraUsageDescription": "Kerb needs access to your camera so you can take photos and upload them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },

    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUserPermission": "Kerb uses your location to find nearby drivers and suggest the fastest pickup sport"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kerb uses your photo library so you can choose a profile photo",
          "cameraPermission": "Kerb uses the camera to take a profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
